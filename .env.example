# Meridian Environment Variables
# Copy this file to .env and fill in your values

# PostgreSQL connection (async — used by FastAPI)
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# PostgreSQL connection (sync — used by profilers)
SYNC_DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian

# API route prefix
API_PREFIX=/api/v1

# Dashboard — URL of the backend API (used by Streamlit)
API_URL=http://localhost:8000/api/v1
